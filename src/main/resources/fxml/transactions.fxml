<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane stylesheets="@../css/styles.css"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="sk.sporixx.ui.TransactionController">

    <BorderPane>
        <left>
            <fx:include source="sidebar.fxml"/>
        </left>
        <center>
            <ScrollPane styleClass="dashboard-scroll" fitToWidth="true" hbarPolicy="NEVER">
                <VBox styleClass="dashboard-content" spacing="24">

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="%transactions.title" styleClass="dashboard-title"/>
                        </VBox>
                    </HBox>

                    <!-- Tabuľka karta -->
                    <VBox styleClass="dashboard-card" spacing="16" VBox.vgrow="ALWAYS">

                        <!-- Tabuľka header -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="%transactions.manage" styleClass="dashboard-card-title"
                                   HBox.hgrow="ALWAYS"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="newTransactionBtn" text="%transactions.new"
                                    styleClass="btn-export" onAction="#handleNewTransaction"/>
                            <Button fx:id="editBtn" styleClass="btn-icon-edit" onAction="#handleEdit">
                                <graphic>
                                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                        <image><Image url="@/assets/icons/icon_edit.png"/></image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="deleteBtn" styleClass="btn-icon-danger" onAction="#handleDelete">
                                <graphic>
                                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                        <image><Image url="@/assets/icons/icon_delete.png"/></image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </HBox>

                        <!-- Search + Filter -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <HBox styleClass="search-box" spacing="8" alignment="CENTER_LEFT"
                                  HBox.hgrow="SOMETIMES">
                                <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                                    <image><Image url="@/assets/icons/icon_search.png"/></image>
                                </ImageView>
                                <TextField fx:id="searchField"
                                           promptText="%transactions.search"
                                           styleClass="search-field"
                                           HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox fx:id="accountFilterContainer" spacing="8"/>
                        </HBox>

                        <!-- Hlavičky stĺpcov -->
                        <HBox styleClass="table-header" spacing="0">
                            <Label text="%transactions.col.name" styleClass="table-header-cell"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label text="%transactions.col.category" styleClass="table-header-cell"
                                   HBox.hgrow="SOMETIMES" maxWidth="Infinity"/>
                            <Label text="%transactions.col.need_want" styleClass="table-header-cell"
                                   minWidth="80" prefWidth="100"/>
                            <Label text="%transactions.col.type" styleClass="table-header-cell"
                                   minWidth="80" prefWidth="100"/>
                            <Label text="%transactions.col.date" styleClass="table-header-cell"
                                   minWidth="100" prefWidth="120"/>
                            <Label text="%transactions.col.amount" styleClass="table-header-cell"
                                   minWidth="80" prefWidth="100"/>
                        </HBox>

                        <!-- Riadky transakcií -->
                        <ScrollPane styleClass="activities-scroll" fitToWidth="true"
                                    hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                            <VBox fx:id="transactionsList" styleClass="transactions-list"/>
                        </ScrollPane>

                    </VBox>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>

    <!-- Modal overlay -->
    <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false" managed="false">
        <VBox styleClass="modal-card" spacing="20" maxWidth="640" maxHeight="600">

            <!-- Modal header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="modalTitle" styleClass="modal-title" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane onMouseClicked="#onModalConfirm" styleClass="modal-action-btn">
                    <ImageView fitWidth="13" fitHeight="13" preserveRatio="true">
                        <image><Image url="@/assets/icons/icon_confirm.png"/></image>
                    </ImageView>
                </StackPane>
                <StackPane onMouseClicked="#onModalClose" styleClass="modal-action-btn">
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                        <image><Image url="@/assets/icons/icon_close.png"/></image>
                    </ImageView>
                </StackPane>
            </HBox>

            <!-- Between accounts checkbox -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <CheckBox fx:id="betweenAccountsCheck"
                          text="%transactions.modal.between_accounts"
                          styleClass="modal-field-label"
                          onAction="#onBetweenAccountsChanged"/>
            </HBox>

            <!-- From + To account -->
            <HBox spacing="16">
                <VBox fx:id="fromAccountSection" spacing="6" HBox.hgrow="ALWAYS"
                      visible="false" managed="false">
                    <Label fx:id="fromAccountLabel" styleClass="modal-field-label"/>
                    <ComboBox fx:id="fromAccountCombo" styleClass="modal-input"
                              maxWidth="Infinity"/>
                </VBox>
                <VBox fx:id="toAccountSection" spacing="6" HBox.hgrow="ALWAYS"
                      visible="false" managed="false">
                    <Label fx:id="toAccountLabel" styleClass="modal-field-label"/>
                    <ComboBox fx:id="toAccountCombo" styleClass="modal-input"
                              maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- Type + Name -->
            <HBox spacing="16">
                <VBox fx:id="typeSection" spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="typeLabel" styleClass="modal-field-label"/>
                    <ComboBox fx:id="typeCombo" styleClass="modal-input" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="nameLabel" styleClass="modal-field-label"/>
                    <TextField fx:id="nameField" styleClass="modal-input"/>
                </VBox>
            </HBox>

            <!-- Category + Need/Want -->
            <HBox fx:id="categorySection" spacing="16" visible="false" managed="false">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="categoryLabel" styleClass="modal-field-label"/>
                    <ComboBox fx:id="categoryCombo" styleClass="modal-input"
                              maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="needWantLabel" styleClass="modal-field-label"/>
                    <ComboBox fx:id="needWantCombo" styleClass="modal-input"
                              maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- Date + Amount -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="dateLabel" styleClass="modal-field-label"/>
                    <DatePicker fx:id="datePicker" styleClass="modal-input"
                                maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="amountLabel" styleClass="modal-field-label"/>
                    <TextField fx:id="amountField" styleClass="modal-input"/>
                </VBox>
            </HBox>

            <!-- Amount preview -->
            <Label fx:id="amountPreview" styleClass="modal-amount-preview"/>

            <Label fx:id="modalErrorLabel" styleClass="modal-error-label"
                   visible="false" managed="false" wrapText="true"/>

        </VBox>
    </StackPane>

</StackPane>