<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sk.sporixx.ui.FamilyManagementController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <center>
        <StackPane>
            <ScrollPane styleClass="dashboard-scroll" fitToWidth="true" hbarPolicy="NEVER">
                <VBox styleClass="dashboard-content" spacing="24">

                    <Label text="%family.title" styleClass="dashboard-title"/>

                    <!-- Family Members sekcia -->
                    <VBox styleClass="dashboard-card" spacing="16">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="%family.members.title" styleClass="dashboard-card-title"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button fx:id="addUserBtn" styleClass="btn-primary-small"
                                    text="%family.add_user" onAction="#handleAddUser" minWidth="80"/>
                        </HBox>
                        <Label fx:id="familyErrorLabel" styleClass="modal-error-label"
                               visible="false" managed="false"/>
                        <HBox fx:id="membersRow" spacing="16" alignment="CENTER_LEFT"/>
                    </VBox>

                    <!-- Family user accounts sekcia -->
                    <VBox fx:id="familyAccountsSection" styleClass="dashboard-card" spacing="16"
                          visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="familyAccountsTitle" styleClass="dashboard-card-title"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                        <Label text="%management.accounts.section_default" styleClass="activities-group-title"/>
                        <HBox fx:id="familyDefaultAccountsRow" spacing="8" alignment="CENTER_LEFT"/>
                        <Label text="%management.accounts.section_saving" styleClass="activities-group-title"/>
                        <HBox fx:id="familySavingAccountsRow" spacing="8" alignment="CENTER_LEFT"/>
                        <Label fx:id="familyAccountsErrorLabel" styleClass="modal-error-label"
                               visible="false" managed="false"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- ═══ Add User Modal ═══ -->
            <StackPane fx:id="addUserModalOverlay" styleClass="modal-overlay" visible="false" managed="false">
                <VBox styleClass="modal-card" spacing="20" maxWidth="440" maxHeight="250">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="%family.modal.add_title" styleClass="modal-title" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <StackPane onMouseClicked="#onAddUserConfirm" styleClass="modal-action-btn">
                            <ImageView fitWidth="13" fitHeight="13" preserveRatio="true">
                                <image><Image url="@/assets/icons/icon_confirm.png"/></image>
                            </ImageView>
                        </StackPane>
                        <StackPane onMouseClicked="#onAddUserClose" styleClass="modal-action-btn">
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <image><Image url="@/assets/icons/icon_close.png"/></image>
                            </ImageView>
                        </StackPane>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="%family.modal.email" styleClass="modal-field-label"/>
                        <TextField fx:id="addUserEmailField" styleClass="modal-input"
                                   promptText="%family.modal.email_placeholder"/>
                    </VBox>
                    <Label fx:id="addUserModalErrorLabel" styleClass="modal-error-label"
                           visible="false" managed="false"/>
                </VBox>
            </StackPane>

            <!-- ═══ Edit Saving Account Modal ═══ -->
            <StackPane fx:id="editSavingModalOverlay" styleClass="modal-overlay" visible="false" managed="false">
                <VBox styleClass="modal-card" spacing="20" maxWidth="440" maxHeight="440">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="%management.accounts.modal.edit_title" styleClass="modal-title" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <StackPane onMouseClicked="#onEditSavingConfirm" styleClass="modal-action-btn">
                            <ImageView fitWidth="13" fitHeight="13" preserveRatio="true">
                                <image><Image url="@/assets/icons/icon_confirm.png"/></image>
                            </ImageView>
                        </StackPane>
                        <StackPane onMouseClicked="#onEditSavingClose" styleClass="modal-action-btn">
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <image><Image url="@/assets/icons/icon_close.png"/></image>
                            </ImageView>
                        </StackPane>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="%dashboard.modal.description" styleClass="modal-field-label"/>
                        <TextField fx:id="editSavingDescField" styleClass="modal-input"
                                   promptText="%dashboard.modal.description"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="%dashboard.modal.goal" styleClass="modal-field-label"/>
                        <TextField fx:id="editSavingGoalField" styleClass="modal-input" promptText="0.00"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="%dashboard.modal.date" styleClass="modal-field-label"/>
                        <DatePicker fx:id="editSavingDatePicker" styleClass="modal-input" maxWidth="Infinity"/>
                    </VBox>
                    <Label fx:id="editSavingModalErrorLabel" styleClass="modal-error-label"
                           visible="false" managed="false"/>
                </VBox>
            </StackPane>

        </StackPane>
    </center>
</BorderPane>