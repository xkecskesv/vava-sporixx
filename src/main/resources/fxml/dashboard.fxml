<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>

<BorderPane stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sk.sporixx.ui.DashboardController">

    <!-- Sidebar -->
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <!-- Hlavný obsah -->
    <center>
        <VBox styleClass="dashboard-content" spacing="24">

            <!-- Header -->
            <VBox styleClass="dashboard-header" spacing="4">
                <Label fx:id="dashboardTitle" text="Overview" styleClass="dashboard-title"/>
                <Label fx:id="totalBalanceLabel" text="Total balance" styleClass="dashboard-subtitle"/>
                <Label fx:id="totalBalance" text="€124,256.53" styleClass="dashboard-balance"/>
            </VBox>

            <!-- Account karty - generujú sa dynamicky v DashboardController -->
            <HBox fx:id="accountsContainer" styleClass="accounts-container" spacing="16" alignment="CENTER_LEFT"/>

            <!-- Spodná sekcia: Analytics + Activities -->
            <HBox spacing="16" HBox.hgrow="ALWAYS">

                <!-- Analytics -->
                <VBox styleClass="dashboard-card" spacing="8" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="analyticsTitle" text="Analytics" styleClass="dashboard-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="periodComboBox" styleClass="analytics-badge"/>
                    </HBox>
                    <Label fx:id="analyticsAmount" text="€194,290.47" styleClass="analytics-amount"/>
                    <Label fx:id="totalIncomeLabel" text="Total income" styleClass="analytics-subtitle"/>
                    <LineChart fx:id="analyticsChart" styleClass="analytics-chart"
                               VBox.vgrow="ALWAYS" animated="false" legendVisible="false"
                               createSymbols="false" verticalGridLinesVisible="false">
                        <xAxis><CategoryAxis side="BOTTOM" styleClass="analytics-axis"/></xAxis>
                        <yAxis><NumberAxis side="LEFT" styleClass="analytics-axis" autoRanging="true"/></yAxis>
                    </LineChart>
                </VBox>

                <!-- Activities -->
                <VBox styleClass="dashboard-card" prefWidth="340" minWidth="300" HBox.hgrow="SOMETIMES">
                    <Label fx:id="activitiesTitle" text="Activities" styleClass="dashboard-card-title"/>
                    <ScrollPane styleClass="activities-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                        <VBox fx:id="activitiesList" styleClass="activities-list" spacing="16">
                            <!-- Generuje sa dynamicky v DashboardController -->
                        </VBox>
                    </ScrollPane>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>