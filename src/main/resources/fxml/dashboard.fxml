<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.control.DatePicker?>
<StackPane stylesheets="@../css/styles.css"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="sk.sporixx.ui.DashboardController">

    <!-- Hlavný obsah -->
    <BorderPane>
        <left>
            <fx:include source="sidebar.fxml"/>
        </left>
        <center>
            <VBox styleClass="dashboard-content" spacing="24">

                <!-- Header -->
                <VBox styleClass="dashboard-header" spacing="4">
                    <Label fx:id="dashboardTitle" text="Overview" styleClass="dashboard-title"/>
                    <Label fx:id="totalBalanceLabel" text="Total balance" styleClass="dashboard-subtitle"/>
                    <Label fx:id="totalBalance" text="€124,256.53" styleClass="dashboard-balance"/>
                </VBox>

                <!-- Account karty -->
                <HBox fx:id="accountsContainer" styleClass="accounts-container" spacing="16" alignment="CENTER_LEFT"/>

                <!-- Spodná sekcia: Analytics + Activities -->
                <HBox spacing="16" HBox.hgrow="ALWAYS">

                    <!-- Analytics -->
                    <VBox styleClass="dashboard-card" spacing="8" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="analyticsTitle" text="Analytics" styleClass="dashboard-card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="periodComboBox" styleClass="analytics-badge"/>
                        </HBox>
                        <Label fx:id="analyticsAmount" text="€194,290.47" styleClass="analytics-amount"/>
                        <Label fx:id="totalIncomeLabel" text="Total income" styleClass="analytics-subtitle"/>
                        <LineChart fx:id="analyticsChart" styleClass="analytics-chart"
                                   VBox.vgrow="ALWAYS" animated="false" legendVisible="false"
                                   createSymbols="false" verticalGridLinesVisible="false">
                            <xAxis><CategoryAxis side="BOTTOM" styleClass="analytics-axis"/></xAxis>
                            <yAxis><NumberAxis fx:id="yAxis" side="LEFT" styleClass="analytics-axis" autoRanging="true"/></yAxis>
                        </LineChart>
                    </VBox>

                    <!-- Activities -->
                    <VBox styleClass="dashboard-card" prefWidth="340" minWidth="300" HBox.hgrow="SOMETIMES">
                        <Label fx:id="activitiesTitle" text="Activities" styleClass="dashboard-card-title"/>
                        <ScrollPane styleClass="activities-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                            <VBox fx:id="activitiesList" styleClass="activities-list" spacing="16"/>
                        </ScrollPane>
                    </VBox>

                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <!-- Overlay — nový účet -->
    <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false" managed="false">
        <VBox styleClass="modal-card" spacing="20" maxWidth="440" maxHeight="500">

            <!-- Header -->
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="modalTitle" styleClass="modal-title" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane onMouseClicked="#onModalConfirm" styleClass="modal-action-btn">
                    <ImageView fx:id="modalConfirm" fitWidth="13" fitHeight="13"
                               preserveRatio="true">
                        <image><Image url="@/assets/icons/icon_confirm.png"/></image>
                    </ImageView>
                </StackPane>
                <StackPane onMouseClicked="#onModalClose" styleClass="modal-action-btn">
                    <ImageView fx:id="modalClose" fitWidth="16" fitHeight="16"
                               preserveRatio="true">
                        <image><Image url="@/assets/icons/icon_close.png"/></image>
                    </ImageView>
                </StackPane>
            </HBox>

            <!-- Type of account -->
            <VBox spacing="6">
                <Label fx:id="modalTypeLabel" styleClass="modal-field-label"/>
                <ComboBox fx:id="accountTypeComboBox" styleClass="modal-input" maxWidth="Infinity"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="6">
                <Label fx:id="modalDescLabel" styleClass="modal-field-label"/>
                <TextField fx:id="accountDescField" styleClass="modal-input"/>
            </VBox>

            <!-- Amount -->
            <VBox spacing="6">
                <Label fx:id="modalAmountLabel" styleClass="modal-field-label"/>
                <TextField fx:id="accountAmountField" styleClass="modal-input"/>
            </VBox>

            <!-- Goal — len pre Saving Account -->
            <VBox fx:id="goalSection" spacing="6" managed="false" visible="false">
                <Label fx:id="modalGoalLabel" styleClass="modal-field-label"/>
                <TextField fx:id="accountGoalField" styleClass="modal-input"/>
                <Label fx:id="modalDateLabel" styleClass="modal-field-label"/>
                <DatePicker fx:id="accountDatePicker" styleClass="modal-input" maxWidth="Infinity"/>
            </VBox>

            <!-- Suma preview -->
            <Label fx:id="modalAmountPreview" styleClass="modal-amount-preview"/>

            <Label fx:id="modalErrorLabel" styleClass="modal-error-label" wrapText="true" managed="false" visible="false" />

        </VBox>
    </StackPane>

</StackPane>