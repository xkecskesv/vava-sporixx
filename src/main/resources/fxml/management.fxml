<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sk.sporixx.ui.ManagementController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <center>
        <StackPane>
            <ScrollPane styleClass="dashboard-scroll" fitToWidth="true" hbarPolicy="NEVER">
                <VBox styleClass="dashboard-content" spacing="24">

                    <Label text="%management.title" styleClass="dashboard-title"/>

                    <HBox spacing="24">

                        <!-- Categories karta -->
                        <VBox styleClass="dashboard-card" spacing="16" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="%management.categories.title"
                                       styleClass="dashboard-card-title" HBox.hgrow="ALWAYS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="categoryDeleteBtn" styleClass="btn-icon-delete"
                                        onAction="#handleCategoryDelete">
                                    <graphic>
                                        <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                                            <image><Image url="@/assets/icons/icon_delete.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="categoryEditBtn" styleClass="btn-icon-edit"
                                        onAction="#handleCategoryEdit">
                                    <graphic>
                                        <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                                            <image><Image url="@/assets/icons/icon_edit.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="categoryAddBtn" styleClass="modal-confirm-btn"
                                        onAction="#handleCategoryAdd">
                                    <graphic>
                                        <ImageView fitWidth="13" fitHeight="13" preserveRatio="true">
                                            <image><Image url="@/assets/icons/icon_confirm.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </HBox>
                            <VBox fx:id="categoriesList" spacing="6"/>
                            <Label fx:id="categoryErrorLabel" styleClass="modal-error-label"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- Account Manager karta -->
                        <VBox styleClass="dashboard-card" spacing="16" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="%management.accounts.title"
                                       styleClass="dashboard-card-title" HBox.hgrow="ALWAYS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="accountAddBtn" styleClass="modal-confirm-btn"
                                        onAction="#handleAccountAdd">
                                    <graphic>
                                        <ImageView fitWidth="13" fitHeight="13" preserveRatio="true">
                                            <image><Image url="@/assets/icons/icon_confirm.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </HBox>
                            <Label fx:id="accountManagerSubtitle" styleClass="analytics-subtitle"/>
                            <Label fx:id="accountManagerCurrency" styleClass="analytics-subtitle"/>

                            <Label text="%management.accounts.section_default"
                                   styleClass="activities-group-title"/>
                            <HBox fx:id="defaultAccountsRow" spacing="16"/>

                            <Label text="%management.accounts.section_saving"
                                   styleClass="activities-group-title"/>
                            <HBox fx:id="savingAccountsRow" spacing="16"/>

                            <Label fx:id="accountErrorLabel" styleClass="modal-error-label"
                                   visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <!-- Recurring karta -->
                    <HBox spacing="24">
                        <VBox styleClass="dashboard-card" spacing="16" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="%management.recurring.title"
                                       styleClass="dashboard-card-title" HBox.hgrow="ALWAYS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="recurringDeleteBtn" styleClass="btn-icon-delete"
                                        onAction="#handleRecurringDelete">
                                    <graphic>
                                        <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                                            <image><Image url="@/assets/icons/icon_delete.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="recurringEditBtn" styleClass="btn-icon-edit"
                                        onAction="#handleRecurringEdit">
                                    <graphic>
                                        <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                                            <image><Image url="@/assets/icons/icon_edit.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="recurringAddBtn" styleClass="modal-confirm-btn"
                                        onAction="#handleRecurringAdd">
                                    <graphic>
                                        <ImageView fitWidth="13" fitHeight="13" preserveRatio="true">
                                            <image><Image url="@/assets/icons/icon_confirm.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </HBox>
                            <VBox fx:id="recurringList" spacing="6"/>
                            <Label fx:id="recurringErrorLabel" styleClass="modal-error-label"
                                   visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>

            <!-- Category Modal -->
            <StackPane fx:id="categoryModalOverlay" styleClass="modal-overlay"
                       visible="false" managed="false">
                <VBox styleClass="modal-box" spacing="16" maxWidth="420">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="categoryModalTitle" styleClass="modal-title" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button styleClass="modal-action-btn" onAction="#onCategoryModalConfirm">
                            <graphic>
                                <ImageView fitWidth="13" fitHeight="13" preserveRatio="true">
                                    <image><Image url="@/assets/icons/icon_confirm.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button styleClass="modal-action-btn" onAction="#onCategoryModalClose">
                            <graphic>
                                <ImageView fitWidth="14" fitHeight="14" preserveRatio="true">
                                    <image><Image url="@/assets/icons/icon_close.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="%management.categories.modal.name" styleClass="modal-field-label"/>
                        <TextField fx:id="categoryNameField" styleClass="modal-input"
                                   promptText="%management.categories.modal.name_placeholder"/>
                    </VBox>
                    <Label fx:id="categoryModalErrorLabel" styleClass="modal-error-label"
                           visible="false" managed="false"/>
                </VBox>
            </StackPane>

        </StackPane>
    </center>
</BorderPane>