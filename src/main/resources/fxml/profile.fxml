<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<BorderPane stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.sporixx.ui.ProfileController">
    <!-- Sidebar navigation -->
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <!-- Main profile content -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="profile-scroll">
            <VBox styleClass="profile-content" spacing="20" maxHeight="Infinity">
                <padding>
                    <Insets top="32" right="28" bottom="32" left="28"/>
                </padding>

                <!-- Header: page title and logout action -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="profileTitle" styleClass="profile-title" text="Profile"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="logoutButton" styleClass="profile-logout-btn" onAction="#handleLogout" text="Logout"/>
                </HBox>

                <!-- Primary card: account management and profile details -->
                <VBox styleClass="profile-main-card" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                    <GridPane VBox.vgrow="ALWAYS" maxHeight="Infinity">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="40"/>
                            <ColumnConstraints percentWidth="60"/>
                        </columnConstraints>

                        <!-- Left column: account management -->
                        <VBox styleClass="profile-management-column" GridPane.columnIndex="0" GridPane.vgrow="ALWAYS" alignment="TOP_CENTER">
                            <padding>
                                <Insets top="24" right="30" bottom="24" left="30"/>
                            </padding>

                            <VBox alignment="CENTER_LEFT">
                                <Label fx:id="managementTitle" styleClass="profile-section-title" text="Account Management"/>
                            </VBox>

                            <Region prefHeight="60"/>

                            <!-- Profile photo and upload action -->
                            <VBox alignment="CENTER">
                                <ImageView fx:id="profileImage" fitWidth="210" fitHeight="210" styleClass="profile-avatar-large"/>
                                <Region prefHeight="20"/>
                                <Button fx:id="uploadPhotoButton" styleClass="profile-upload-btn" text="Upload Photo" onAction="#handleUploadPhoto" prefWidth="150" prefHeight="20"/>
                            </VBox>

                            <Region prefHeight="40"/>

                            <!-- Password update form -->
                            <VBox spacing="5">
                                <Label fx:id="oldPasswordLabel" styleClass="profile-label" text="Old Password:"/>
                                <PasswordField fx:id="oldPasswordField" styleClass="profile-input" promptText="***************" maxWidth="Infinity"/>
                                <Region prefHeight="15"/>
                                <Label fx:id="newPasswordLabel" styleClass="profile-label" text="New Password:"/>
                                <PasswordField fx:id="newPasswordField" styleClass="profile-input" promptText="***************" maxWidth="Infinity"/>
                            </VBox>

                            <Region prefHeight="20"/>

                            <VBox alignment="CENTER">
                                <Button fx:id="changePasswordButton" styleClass="profile-upload-btn" text="Change Password" onAction="#handleChangePassword" prefWidth="150" prefHeight="20"/>
                                <Label fx:id="passwordFeedbackLabel" styleClass="profile-feedback-line" wrapText="true" visible="false" managed="false"/>
                            </VBox>
                        </VBox>

                        <Separator orientation="VERTICAL" styleClass="profile-divider" GridPane.columnIndex="0" GridPane.halignment="RIGHT"/>

                        <!-- Right column: personal details and progress -->
                        <VBox styleClass="profile-information-column" spacing="10" GridPane.columnIndex="1" GridPane.vgrow="ALWAYS">
                            <padding>
                                <Insets top="24" right="24" bottom="24" left="24"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="profileSubtitle" styleClass="profile-section-title" text="Profile Information"/>
                                <Label fx:id="autosaveFeedbackLabel" styleClass="profile-feedback-line" wrapText="true" visible="false" managed="false"/>
                            </HBox>
                            <Region VBox.vgrow="ALWAYS"/>

                            <HBox spacing="12" maxWidth="Infinity">
                                <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label fx:id="firstNameLabel" styleClass="profile-label" text="First Name"/>
                                    <TextField fx:id="firstNameField" styleClass="profile-input" promptText="John" maxWidth="Infinity" prefHeight="36"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label fx:id="lastNameLabel" styleClass="profile-label" text="Last Name"/>
                                    <TextField fx:id="lastNameField" styleClass="profile-input" promptText="Doe" maxWidth="Infinity" prefHeight="36"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="12" alignment="CENTER" maxWidth="Infinity">
                                <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label fx:id="emailLabel" styleClass="profile-label" text="E-mail"/>
                                    <TextField fx:id="emailField" styleClass="profile-input" promptText="john.doe@email.com" maxWidth="Infinity" prefWidth="0" prefHeight="36"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label fx:id="genderLabel" styleClass="profile-label" text="Gender"/>
                                    <ComboBox fx:id="genderComboBox" styleClass="profile-input" promptText="Male / Female / -" prefHeight="36" prefWidth="0" maxWidth="Infinity"/>
                                </VBox>
                            </HBox>

                            <Region prefHeight="3"/>

                            <VBox spacing="5" alignment="CENTER_LEFT">
                                <Label text="%profile.information.parent_status" styleClass="profile-checkbox-label"/>
                                <CheckBox fx:id="parentCheckBox" styleClass="profile-checkbox" />
                            </VBox>

                            <Region VBox.vgrow="ALWAYS"/>

                            <Label fx:id="financialLevelLabel" styleClass="profile-label" text="Financial Level"/>
                            <VBox spacing="3" alignment="CENTER_LEFT">
                                <Label fx:id="financialLevelValue" styleClass="profile-financial-level" text="Financial Pro"/>
                                <ProgressBar fx:id="xpProgressBar" styleClass="profile-progress" progress="1" maxWidth="Infinity" minHeight="12"/>
                            </VBox>

                            <Region VBox.vgrow="ALWAYS"/>
                            <Label fx:id="milestonesTitle" styleClass="profile-section-title" text="Milestones"/>

                            <HBox spacing="10" alignment="CENTER" maxWidth="Infinity">
                                <VBox styleClass="milestone-card" spacing="8" alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label fx:id="milestone1Title" styleClass="milestone-title" text="Savings Master"/>
                                    <ImageView fx:id="milestone1Icon" fitWidth="70" fitHeight="70" preserveRatio="true"
                                               styleClass="milestone-icon">
                                        <!-- TODO Replace with actual milestone progres icon -->
                                        <Image url="@../assets/icons/milestone_0.png"/>
                                    </ImageView>
                                    <Label fx:id="milestone1Subtitle" styleClass="milestone-subtitle" text="Getting Started"/>
                                    <Label fx:id="milestone1Desc" wrapText="true" styleClass="milestone-desc" textAlignment="CENTER"
                                           text="Start saving money and build your financial foundation."/>
                                </VBox>

                                <VBox styleClass="milestone-card" spacing="8" alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label fx:id="milestone2Title" styleClass="milestone-title" text="Budget Keeper"/>
                                    <ImageView fx:id="milestone2Icon" fitWidth="70" fitHeight="70" preserveRatio="true"
                                               styleClass="milestone-icon">
                                        <!-- TODO Replace with actual milestone progres icon -->
                                        <Image url="@../assets/icons/milestone_0.png"/>
                                    </ImageView>
                                    <Label fx:id="milestone2Subtitle" styleClass="milestone-subtitle" text="Getting Started"/>
                                    <Label fx:id="milestone2Desc" wrapText="true" styleClass="milestone-desc" textAlignment="CENTER"
                                           text="Start tracking your spending and understand your budget."/>
                                </VBox>

                                <VBox styleClass="milestone-card" spacing="8" alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label fx:id="milestone3Title" styleClass="milestone-title" text="Investor"/>
                                    <ImageView fx:id="milestone3Icon" fitWidth="70" fitHeight="70" preserveRatio="true"
                                               styleClass="milestone-icon">
                                        <!-- TODO Replace with actual milestone progres icon -->
                                        <Image url="@../assets/icons/milestone_0.png"/>
                                    </ImageView>
                                    <Label fx:id="milestone3Subtitle" styleClass="milestone-subtitle" text="Getting Started"/>
                                    <Label fx:id="milestone3Desc" wrapText="true" styleClass="milestone-desc" textAlignment="CENTER"
                                           text="Start learning about investing and building your strategy."/>
                                </VBox>

                                <VBox styleClass="milestone-card" spacing="8" alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <Label fx:id="milestone4Title" styleClass="milestone-title" text="Smart Spender"/>
                                    <ImageView fx:id="milestone4Icon" fitWidth="70" fitHeight="70" preserveRatio="true"
                                               styleClass="milestone-icon">
                                        <!-- TODO Replace with actual milestone progres icon -->
                                        <Image url="@../assets/icons/milestone_0.png"/>
                                    </ImageView>
                                    <Label fx:id="milestone4Subtitle" styleClass="milestone-subtitle" text="Getting Started"/>
                                    <Label fx:id="milestone4Desc" wrapText="true" styleClass="milestone-desc" textAlignment="CENTER"
                                           text="Start tracking your spending and understand your habits."/>
                                </VBox>
                            </HBox>

                            <Region prefHeight="5"/>

                            <VBox alignment="CENTER">
                                <Label fx:id="milestonesFooter" wrapText="true" styleClass="milestone-footer" textAlignment="CENTER" text="Earn XP by completing milestones and improving your financial habits. As you gain XP, your level increases."/>
                            </VBox>
                        </VBox>
                    </GridPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

